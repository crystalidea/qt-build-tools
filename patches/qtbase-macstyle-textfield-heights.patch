+                if (qt_apple_runningWithLiquidGlass())
+                    ret.adjust(0, -fw, 0, fw);
                 if (spin->buttonSymbols != QAbstractSpinBox::NoButtons) {
                     ret.setWidth(spin->rect.width() - spinBoxSep - spinner_w);
                     ret = visualRect(spin->direction, spin->rect, ret);
@@ -6611,9 +6621,30 @@
