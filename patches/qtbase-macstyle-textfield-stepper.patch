                 ret.setRect(x + spin->rect.x(), y + spin->rect.y(), spinner_w, spin->rect.height() - y * 2);
@@ -6656,6 +6701,12 @@
                 // Room for the text insets of the edit field (see SE_LineEditContents)
                 sz.rwidth() += textFieldLiquidGlassTextLeading + textFieldLiquidGlassTextTrailing;
             }
+            // The stepper the spin box gets at this height, whatever its rect is now
